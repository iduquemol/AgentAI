# Conexion al SQL Server del host desde contenedores Docker
# Para instancia por defecto:   Server=host.docker.internal;Database=ConvAgent;User Id=sa;Password=...;TrustServerCertificate=True;
# Para instancia nombrada:      Server=host.docker.internal\NOMBRE_INSTANCIA;Database=ConvAgent;User Id=sa;Password=...;TrustServerCertificate=True;
DB_CONNECTION_STRING=

# JWT — minimo 32 caracteres
JWT_SECRET_KEY=

# Anthropic Claude API
CLAUDE_API_KEY=sk-ant-...

# Redis (dentro de Docker apunta al servicio redis del compose)
REDIS_CONNECTION_STRING=redis:6379

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000
VITE_SIGNALR_HUB_URL=http://localhost:5000/hubs/conversation
